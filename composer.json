{
    "name": "italystrap/asset",
    "description": "Handle the CSS and JS register and enqueue for WordPress",
    "keywords": [
        "Asset",
        "register",
        "enqueue",
        "WordPress",
        "localize"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Enea Overclokk",
            "email": "info@overclokk.net",
            "homepage": "https://www.italystrap.com",
            "role": "Developer"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "italystrap/config": "^2.11",
        "italystrap/finder": "dev-master",
        "inpsyde/assets": "^2.8"
    },
    "require-dev": {
        "lucatume/wp-browser": "^4.5",
        "codeception/codeception": "^5.3",
        "codeception/module-asserts": "^3.0",
        "lucatume/function-mocker-le": "^1.0",
        "phpspec/prophecy-phpunit": "^2.3",
        "italystrap/event": "^0.2.2",
        "squizlabs/php_codesniffer": "^3.13",
        "phpcompatibility/php-compatibility": "^9.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpstan/phpstan": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "infection/infection": "^0.29",
        "infection/codeception-adapter": "^0.4.3",
        "dg/bypass-finals": "^1.9",
        "rector/rector": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "ItalyStrap\\Asset\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "scripts": {
        "cs": [
            "@php vendor/bin/phpcs -p"
        ],
        "cs:fix": [
            "@php vendor/bin/phpcbf -p"
        ],
        "stan": [
            "@php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress"
        ],
        "stan:baseline": [
            "@php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress --generate-baseline phpstan-baseline.neon"
        ],
        "unit": [
            "@php vendor/bin/codecept run unit"
        ],
        "integration": [
            "@php vendor/bin/codecept run integration"
        ],
        "tests": [
            "@unit",
            "@integration"
        ],
        "infection": [
            "@php vendor/bin/infection --threads=max"
        ],
        "clean": [
            "@php vendor/bin/codecept clean"
        ],
        "rector": [
            "@php vendor/bin/rector process --dry-run"
        ],
        "rector:fix": [
            "@php vendor/bin/rector process"
        ]
    },
    "support": {
        "issues": "https://github.com/ItalyStrap/asset/issues",
        "source": "https://github.com/ItalyStrap/asset"
    },
    "config": {
        "sort-packages": false,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true
        },
        "platform": {
            "php": "8.2.29"
        }
    }
}
